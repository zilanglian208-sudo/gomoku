/* 智能五子棋 —— 页面样式（深色游戏主题） */
.page {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 24rpx 60rpx;
}
.board-card {
  position: relative;
  padding: 14rpx;
  border-radius: 24rpx;
  background: linear-gradient(145deg, #3a4059, #252939);
  box-shadow: 0 18rpx 46rpx rgba(0, 0, 0, .5);
}
.board { border-radius: 12rpx; }

/* 结算遮罩 */
.overlay {
  position: absolute;
  left: 14rpx; right: 14rpx; top: 14rpx; bottom: 14rpx;
  border-radius: 12rpx;
  background: rgba(12, 14, 22, .74);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  opacity: 0;
  pointer-events: none;
  transition: opacity .35s;
  overflow: hidden;
}
.overlay.show { opacity: 1; pointer-events: auto; }
.confetti-box { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.confetti {
  position: absolute;
  top: -32rpx;
  width: 16rpx; height: 26rpx;
  border-radius: 4rpx;
  opacity: .95;
  animation: cfall linear forwards;
}
@keyframes cfall {
  to { transform: translateY(1300rpx) rotate(680deg); }
}
.result {
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, .6);
}
.overlay.show .result { animation: pop .5s cubic-bezier(.2, 1.6, .4, 1); }
@keyframes pop {
  0% { transform: scale(.35); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}
.result-sub { font-size: 24rpx; color: #b9bfd4; letter-spacing: 2rpx; }

/* 面板 */
.panel {
  width: 100%;
  max-width: 1200rpx;
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  margin-top: 22rpx;
}
.card {
  background: rgba(255, 255, 255, .05);
  border: 1rpx solid rgba(255, 255, 255, .08);
  border-radius: 20rpx;
  padding: 26rpx;
}
.card-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #aab1c6;
  letter-spacing: 6rpx;
  margin-bottom: 20rpx;
}
.turn-row { display: flex; align-items: flex-start; gap: 18rpx; }
.flex-1 { flex: 1; }
.stone-dot {
  width: 40rpx; height: 40rpx;
  border-radius: 50%;
  flex: none;
  margin-top: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, .45);
}
.stone-dot.black { background: radial-gradient(circle at 32% 30%, #6a7180, #0b0d12 70%); }
.stone-dot.white { background: radial-gradient(circle at 32% 30%, #fff, #c4c9d2 75%); border: 2rpx solid #999; }
.stone-dot.breath { animation: breath 1s ease-in-out infinite; }
@keyframes breath {
  50% { transform: scale(1.18); box-shadow: 0 0 24rpx rgba(236, 181, 84, .75); }
}
.status { font-size: 32rpx; font-weight: 600; }
.sub { margin-top: 12rpx; font-size: 23rpx; color: #9aa0b4; line-height: 1.6; }
.time-row { margin-top: 10rpx; font-size: 22rpx; color: #8f96ad; letter-spacing: 2rpx; }
.bubble {
  margin-top: 14rpx;
  font-size: 23rpx;
  color: #f5c96b;
  min-height: 32rpx;
  line-height: 1.5;
  opacity: 0;
  transform: translateY(-6rpx);
  transition: opacity .3s, transform .3s;
}
.bubble.show { opacity: 1; transform: translateY(0); }

/* 设置 */
.field { margin-bottom: 18rpx; }
.lbl { font-size: 22rpx; color: #9aa0b4; margin-bottom: 8rpx; letter-spacing: 2rpx; }
.picker-val {
  padding: 18rpx 22rpx;
  border-radius: 14rpx;
  border: 1rpx solid rgba(255, 255, 255, .14);
  background: #262a3c;
  font-size: 26rpx;
  color: #e8e6df;
}
.btn-row { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; margin-top: 4rpx; }
button.btn {
  width: 100%;
  padding: 18rpx 0;
  border-radius: 14rpx;
  border: 1rpx solid rgba(255, 255, 255, .14);
  background: #262a3c;
  color: #e8e6df;
  font-size: 27rpx;
  line-height: 1.4;
  margin: 0;
}
button.btn::after { border: none; }
button.btn[disabled] { opacity: .38; color: #e8e6df; background: #262a3c; }
button.primary {
  background: linear-gradient(180deg, #ecb554, #cd8f2b);
  color: #251906;
  border: none;
  font-weight: 700;
  letter-spacing: 4rpx;
}
button.again { width: auto; padding: 18rpx 60rpx; }

/* 战绩 */
.score-row { display: flex; align-items: center; justify-content: space-around; text-align: center; }
.score .num { font-size: 46rpx; font-weight: 700; }
.score .lbl { font-size: 22rpx; color: #9aa0b4; margin-top: 4rpx; }
.vs { font-size: 24rpx; color: #6d7387; }
.streak {
  margin-top: 16rpx;
  text-align: center;
  font-size: 24rpx;
  color: #f5b942;
  letter-spacing: 2rpx;
}
.link {
  margin-top: 16rpx;
  width: 100%;
  text-align: center;
  color: #7d84a0;
  font-size: 22rpx;
  text-decoration: underline;
}

/* 说明 */
.help { font-size: 23rpx; color: #aab1c6; line-height: 1.9; }
.help view { margin-bottom: 4rpx; }
