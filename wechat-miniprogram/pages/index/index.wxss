/* 智能五子棋 —— 页面样式（宣纸暖色主题，与网页版一致） */
.page {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 24rpx 60rpx;
}

/* 顶栏 */
.topbar {
  width: 100%;
  max-width: 1200rpx;
  display: flex;
  align-items: baseline;
  gap: 18rpx;
  padding-bottom: 22rpx;
  margin-bottom: 26rpx;
  border-bottom: 1rpx solid #d8cdb8;
}
.seal-mark {
  width: 72rpx; height: 72rpx;
  align-self: center;
  background: #a63c2f;
  color: #f7f2e7;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 700;
  box-shadow: inset 0 0 0 4rpx rgba(247, 242, 231, .25), 0 4rpx 10rpx rgba(140, 49, 37, .35);
  transform: rotate(-3deg);
}
.wordmark { font-size: 52rpx; font-weight: 700; letter-spacing: 10rpx; color: #2b2620; }
.tagline { font-size: 24rpx; color: #6f6656; }

/* 棋盘 */
.board-card {
  position: relative;
  padding: 14rpx;
  border-radius: 6rpx;
  box-shadow: 0 18rpx 52rpx rgba(60, 45, 25, .28), 0 4rpx 10rpx rgba(60, 45, 25, .18);
}
.board { border-radius: 6rpx; }

/* 结算遮罩 */
.overlay {
  position: absolute;
  left: 14rpx; right: 14rpx; top: 14rpx; bottom: 14rpx;
  border-radius: 6rpx;
  background: rgba(28, 22, 15, .6);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  opacity: 0;
  pointer-events: none;
  transition: opacity .35s;
  overflow: hidden;
}
.overlay.show { opacity: 1; pointer-events: auto; }
.confetti-box { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.confetti {
  position: absolute;
  top: -32rpx;
  width: 16rpx; height: 26rpx;
  border-radius: 4rpx;
  opacity: .95;
  animation: cfall linear forwards;
}
@keyframes cfall {
  to { transform: translateY(1300rpx) rotate(680deg); }
}
.result {
  color: #f7f2e7;
  font-size: 76rpx;
  font-weight: 700;
  letter-spacing: 20rpx;
  text-indent: 20rpx;
  padding-bottom: 18rpx;
  border-bottom: 5rpx solid #a63c2f;
}
.overlay.show .result { animation: pop .5s cubic-bezier(.2, 1.6, .4, 1); }
@keyframes pop {
  0% { transform: scale(.4); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}
.result-sub { font-size: 24rpx; color: rgba(247, 242, 231, .75); letter-spacing: 2rpx; }

/* 面板 */
.panel {
  width: 100%;
  max-width: 1200rpx;
  margin-top: 30rpx;
}
.status-block { padding: 4rpx 0 26rpx; }
.status-line { display: flex; align-items: center; gap: 16rpx; }
.stone-dot {
  width: 34rpx; height: 34rpx;
  border-radius: 50%;
  flex: none;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, .4);
}
.stone-dot.black { background: radial-gradient(circle at 32% 30%, #6a7180, #0b0d12 70%); }
.stone-dot.white { background: radial-gradient(circle at 32% 30%, #fff, #c4c9d2 75%); border: 2rpx solid #999; }
.stone-dot.breath { animation: breath 1s ease-in-out infinite; }
@keyframes breath {
  50% { transform: scale(1.25); }
}
.status { font-size: 42rpx; font-weight: 700; color: #2b2620; }
.sub { margin-top: 10rpx; font-size: 24rpx; color: #6f6656; }
.meta-row { margin-top: 6rpx; font-size: 22rpx; color: #a3988a; }
.bubble {
  margin-top: 16rpx;
  font-size: 25rpx;
  color: #8c3125;
  min-height: 36rpx;
  line-height: 1.6;
  opacity: 0;
  transform: translateY(-6rpx);
  transition: opacity .3s, transform .3s;
}
.bubble.show { opacity: 1; transform: translateY(0); }

.rule { border-top: 1rpx solid #d8cdb8; }

.section { padding: 28rpx 0; }
.section-title {
  font-size: 22rpx;
  font-weight: 600;
  color: #a3988a;
  letter-spacing: 6rpx;
  margin-bottom: 20rpx;
}

/* 设置 */
.field { display: flex; align-items: center; margin-bottom: 18rpx; }
.lbl { width: 150rpx; flex: none; font-size: 24rpx; color: #6f6656; }
.picker-val {
  flex: 1;
  padding: 16rpx 20rpx;
  border-radius: 6rpx;
  border: 1rpx solid #d8cdb8;
  background: #fbf7ee;
  font-size: 26rpx;
  color: #2b2620;
}
.btn-row { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; margin-top: 22rpx; }
button.btn {
  width: 100%;
  padding: 18rpx 0;
  border-radius: 6rpx;
  border: 1rpx solid #c9bda6;
  background: #fbf7ee;
  color: #2b2620;
  font-size: 27rpx;
  line-height: 1.4;
  margin: 0;
}
button.btn::after { border: none; }
button.btn[disabled] { opacity: .4; color: #2b2620; background: #fbf7ee; }
button.primary {
  background: #a63c2f;
  border-color: #8c3125;
  color: #f7f2e7;
  font-weight: 600;
  letter-spacing: 6rpx;
  text-indent: 6rpx;
}
button.again { width: auto; padding: 18rpx 60rpx; }

/* 战绩 */
.score-row { display: flex; align-items: flex-end; gap: 36rpx; }
.item { text-align: center; }
.num { font-size: 54rpx; font-weight: 700; line-height: 1.1; color: #2b2620; }
.num.you { color: #a63c2f; }
.lbl { font-size: 20rpx; color: #a3988a; margin-top: 4rpx; }
.dash { color: #d8cdb8; font-size: 40rpx; padding-bottom: 22rpx; }
.streak {
  margin-left: auto;
  align-self: center;
  font-size: 22rpx;
  color: #8c3125;
  border: 1rpx solid #a63c2f;
  border-radius: 4rpx;
  padding: 6rpx 14rpx;
  transform: rotate(-2deg);
}
.link {
  margin-top: 20rpx;
  width: 100%;
  text-align: center;
  color: #a3988a;
  font-size: 22rpx;
  text-decoration: underline;
}

/* 说明 */
.help { font-size: 24rpx; color: #6f6656; line-height: 2; }
.help view { margin-bottom: 4rpx; }

.footer {
  margin-top: 10rpx;
  padding-top: 22rpx;
  width: 100%;
  max-width: 1200rpx;
  border-top: 1rpx solid #d8cdb8;
  text-align: center;
  font-size: 22rpx;
  color: #a3988a;
}
