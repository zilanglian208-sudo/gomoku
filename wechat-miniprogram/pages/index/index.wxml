<view class="page">
  <view class="topbar">
    <view class="seal-mark serif">弈</view>
    <view class="wordmark serif">五子棋</view>
    <view class="tagline">人机对弈</view>
  </view>

  <view class="board-card">
    <canvas type="2d" id="board" class="board"
            style="width:{{boardPx}}px;height:{{boardPx}}px"
            bindtouchend="onBoardTap"></canvas>
    <view class="overlay {{showOver ? 'show' : ''}}">
      <view class="confetti-box">
        <view wx:for="{{confetti}}" wx:key="index" class="confetti" style="{{item}}"></view>
      </view>
      <view class="result serif">{{resultText}}</view>
      <view class="result-sub">{{resultSub}}</view>
      <button class="btn primary again" bindtap="onNewGame">再来一局</button>
    </view>
  </view>

  <view class="panel">
    <view class="status-block">
      <view class="status-line">
        <view class="stone-dot {{turnBlack ? 'black' : 'white'}} {{thinking ? 'breath' : ''}}"></view>
        <view class="status serif">{{statusText}}</view>
      </view>
      <view class="sub">{{subStatus}}</view>
      <view class="meta-row">{{timeText}}</view>
      <view class="bubble {{bubbleShow ? 'show' : ''}}">「{{bubble}}」</view>
    </view>

    <view class="rule"></view>

    <view class="section">
      <view class="section-title">对 局</view>
      <picker mode="selector" range="{{diffNames}}" value="{{diffIndex}}" bindchange="onDifficulty">
        <view class="field">
          <view class="lbl">AI 棋力</view>
          <view class="picker-val">{{diffNames[diffIndex]}} ▾</view>
        </view>
      </picker>
      <picker mode="selector" range="{{firstNames}}" value="{{firstIndex}}" bindchange="onFirst">
        <view class="field">
          <view class="lbl">先手</view>
          <view class="picker-val">{{firstNames[firstIndex]}} ▾</view>
        </view>
      </picker>
      <view class="btn-row">
        <button class="btn primary" bindtap="onNewGame">新对局</button>
        <button class="btn" bindtap="onUndo" disabled="{{!canUndo}}">悔棋</button>
        <button class="btn" bindtap="onHint" disabled="{{!canHint}}">提示</button>
        <button class="btn" bindtap="onToggleSound">{{soundOn ? '音效 · 开' : '音效 · 关'}}</button>
      </view>
    </view>

    <view class="rule"></view>

    <view class="section">
      <view class="section-title">战 绩</view>
      <view class="score-row">
        <view class="item"><view class="num you">{{scoreP}}</view><view class="lbl">你</view></view>
        <view class="dash">—</view>
        <view class="item"><view class="num">{{scoreA}}</view><view class="lbl">AI</view></view>
        <view class="dash">—</view>
        <view class="item"><view class="num">{{scoreD}}</view><view class="lbl">和棋</view></view>
        <view class="streak" wx:if="{{streak >= 2}}">连胜 {{streak}} 场</view>
      </view>
      <view class="link" bindtap="onResetScore">清零战绩</view>
    </view>

    <view class="rule"></view>

    <view class="section help">
      <view class="section-title">说 明</view>
      <view>双方轮流落子，先在横、竖、斜任一方向连成五子者胜。</view>
      <view>悔棋撤回你与 AI 的最后一回合；提示由引擎推荐一手。</view>
    </view>
  </view>

  <view class="footer">纯前端实现，数据仅保存在本机</view>
</view>
